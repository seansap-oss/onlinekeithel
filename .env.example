VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Canonical website address for confirmation and password-reset emails.
# Set this to https://onlinekeithel.vercel.app until the final domain is live.
# Set it in Vercel Production and in your local .env.local; change it when moving hosts.
VITE_PUBLIC_SITE_URL=https://onlinekeithel.vercel.app
# Enable only for local visual review; automatically ignored in production builds.
VITE_PREVIEW_MODE=false
# Vercel server-only secrets. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payment creation stays disabled unless explicitly enabled in a later paid release.
# Fictional fixtures are only for local visual review. Never enable them in Vercel.
VITE_SHOW_SAMPLES=false
